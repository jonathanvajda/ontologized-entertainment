@prefix everything-is-sus: <https://w3id.org/ontoeagle/games/everything-is-sus/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/ontoeagle/games/everything-is-sus/shapes> a owl:Ontology ; owl:versionInfo "0.2.0" ; dcterms:title "Everything's Sus SHACL Shapes"@en ; dcterms:license <https://opensource.org/license/bsd-3-clause> ; rdfs:comment "Structural constraints for the Everything's Sus canonical RDF state."@en .
everything-is-sus:SessionShape a sh:NodeShape ; sh:targetClass everything-is-sus:MysteryGameSession ; sh:property [ sh:path everything-is-sus:hasPlayer ; sh:minCount 3 ; sh:maxCount 6 ; sh:class everything-is-sus:Detective ] ; sh:property [ sh:path everything-is-sus:hasCurrentPlayer ; sh:minCount 1 ; sh:maxCount 1 ; sh:class everything-is-sus:Detective ] ; sh:property [ sh:path everything-is-sus:phase ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ; sh:property [ sh:path everything-is-sus:turnNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ; sh:property [ sh:path everything-is-sus:solutionCommitment ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ; sh:property [ sh:path everything-is-sus:dieResult ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 6 ] ; sh:property [ sh:path everything-is-sus:movementAllowance ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 6 ] .
everything-is-sus:DetectiveShape a sh:NodeShape ; sh:targetClass everything-is-sus:Detective ; sh:property [ sh:path everything-is-sus:usesToken ; sh:minCount 1 ; sh:maxCount 1 ; sh:class everything-is-sus:SuspectToken ] ; sh:property [ sh:path everything-is-sus:controlsPerson ; sh:minCount 1 ; sh:maxCount 1 ; sh:class everything-is-sus:SuspectPerson ] ; sh:property [ sh:path everything-is-sus:playerOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 5 ] ; sh:property [ sh:path everything-is-sus:eliminated ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .
everything-is-sus:HandShape a sh:NodeShape ; sh:targetClass everything-is-sus:PlayerHand ; sh:property [ sh:path everything-is-sus:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class everything-is-sus:Detective ] .
everything-is-sus:PersonShape a sh:NodeShape ; sh:targetClass everything-is-sus:SuspectPerson ; sh:property [ sh:path obo:BFO_0000171 ; sh:minCount 1 ; sh:maxCount 1 ; sh:class everything-is-sus:BoardSite ] .
everything-is-sus:TokenShape a sh:NodeShape ; sh:targetClass everything-is-sus:SuspectToken ; sh:property [ sh:path everything-is-sus:representsPerson ; sh:minCount 1 ; sh:maxCount 1 ; sh:class everything-is-sus:SuspectPerson ] .
everything-is-sus:SingleOccupancyShape a sh:NodeShape ; sh:targetClass everything-is-sus:HallwaySpace ; sh:property [ sh:path [ sh:inversePath obo:BFO_0000171 ] ; sh:maxCount 1 ; sh:class everything-is-sus:SuspectPerson ] .
everything-is-sus:RoomCapacityShape a sh:NodeShape ; sh:targetClass everything-is-sus:Room ; sh:property [ sh:path [ sh:inversePath obo:BFO_0000171 ] ; sh:maxCount 6 ; sh:class everything-is-sus:SuspectPerson ] .
everything-is-sus:MovementActShape a sh:NodeShape ; sh:targetClass everything-is-sus:MovementAct ; sh:property [ sh:path everything-is-sus:originSite ; sh:minCount 1 ; sh:maxCount 1 ; sh:class everything-is-sus:BoardSite ] ; sh:property [ sh:path everything-is-sus:destinationSite ; sh:minCount 1 ; sh:maxCount 1 ; sh:class everything-is-sus:BoardSite ] ; sh:property [ sh:path everything-is-sus:paceCost ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 3 ] .
everything-is-sus:SecretPassageShape a sh:NodeShape ; sh:targetClass everything-is-sus:SecretPassage ; sh:property [ sh:path everything-is-sus:connectsRoom ; sh:minCount 2 ; sh:maxCount 2 ; sh:class everything-is-sus:Room ] .
everything-is-sus:SecretPassageTraversalShape a sh:NodeShape ; sh:targetClass everything-is-sus:SecretPassageTraversalAct ; sh:property [ sh:path everything-is-sus:originSite ; sh:minCount 1 ; sh:maxCount 1 ; sh:class everything-is-sus:Room ] ; sh:property [ sh:path everything-is-sus:destinationSite ; sh:minCount 1 ; sh:maxCount 1 ; sh:class everything-is-sus:Room ] .
everything-is-sus:EvidenceCardShape a sh:NodeShape ; sh:targetClass everything-is-sus:EvidenceCard ; sh:property [ sh:path everything-is-sus:memberOf ; sh:minCount 1 ; sh:maxCount 1 ] .
