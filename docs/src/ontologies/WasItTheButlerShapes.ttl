@prefix butler: <https://w3id.org/ontoeagle/games/was-it-the-butler/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/ontoeagle/games/was-it-the-butler/shapes> a owl:Ontology ; owl:versionInfo "0.1.0" ; dcterms:title "Was It the Butler? SHACL Shapes"@en ; dcterms:license <https://opensource.org/license/bsd-3-clause> ; rdfs:comment "Structural constraints for the Was It the Butler? canonical RDF state."@en .
butler:SessionShape a sh:NodeShape ; sh:targetClass butler:MysteryGameSession ; sh:property [ sh:path butler:hasPlayer ; sh:minCount 3 ; sh:maxCount 6 ; sh:class butler:Detective ] ; sh:property [ sh:path butler:hasCurrentPlayer ; sh:minCount 1 ; sh:maxCount 1 ; sh:class butler:Detective ] ; sh:property [ sh:path butler:phase ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ; sh:property [ sh:path butler:turnNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ; sh:property [ sh:path butler:solutionCommitment ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
butler:DetectiveShape a sh:NodeShape ; sh:targetClass butler:Detective ; sh:property [ sh:path butler:usesToken ; sh:minCount 1 ; sh:maxCount 1 ; sh:class butler:SuspectToken ] ; sh:property [ sh:path butler:playerOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 5 ] ; sh:property [ sh:path butler:eliminated ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .
butler:HandShape a sh:NodeShape ; sh:targetClass butler:PlayerHand ; sh:property [ sh:path butler:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class butler:Detective ] .
butler:TokenShape a sh:NodeShape ; sh:targetClass butler:SuspectToken ; sh:property [ sh:path butler:locatedIn ; sh:minCount 1 ; sh:maxCount 1 ; sh:or ( [ sh:class butler:Room ] [ sh:class butler:Foyer ] ) ] .
butler:EvidenceCardShape a sh:NodeShape ; sh:targetClass butler:EvidenceCard ; sh:property [ sh:path butler:memberOf ; sh:minCount 1 ; sh:maxCount 1 ] .
